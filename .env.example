# Copy to .env and fill in. direnv loads it; see the README for running
# without direnv.

# The bot's token, from the Discord Developer Portal. Required.
DISCORD_TOKEN=

# The people the bot listens to, in any channel it can see, separated by
# commas. Required: whoever is listed here can have Claude act on this
# machine.
CLAUDE_USER_IDS=

# The directory Claude works in. Give an absolute path when using
# `bazel run`, which starts the bot somewhere inside Bazel's output tree.
CLAUDE_DIRECTORY=

# The model: a name or an alias such as sonnet. Your default if empty.
CLAUDE_MODEL=

# What Claude may do unasked: ask (the default: it asks in the channel),
# auto (Claude Code judges what is safe; see `claude auto-mode config`),
# default, accept-edits, plan or bypass.
CLAUDE_PERMISSIONS=ask
